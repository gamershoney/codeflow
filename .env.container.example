# Two DNS hostnames that resolve to this server. Caddy provisions HTTPS for both.
CODEFLOW_DOMAIN=codeflow.example.com
POCKET_ID_DOMAIN=auth.example.com

# Generate with: openssl rand -base64 32
# Keep this stable. Losing it makes encrypted Pocket ID data unreadable.
POCKET_ID_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Host directory mounted read-only at /repos for repository discovery.
# Windows example: H:/ProjectsFolder
CODEFLOW_REPOSITORY_ROOT=./repositories

# Optional privacy/update choices passed to Pocket ID.
ANALYTICS_DISABLED=true
VERSION_CHECK_DISABLED=true
ICON_LIBRARY_URL=disabled
